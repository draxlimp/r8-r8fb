{
  "name": "r8-community-bot",
  "version": "10.0.0",
  "private": true,
  "description": "Bot de comunidade e proteção para Discord com X em Canvas, limpeza automática, utilidades, tickets e moderação avançada.",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "clean": "node scripts/clean.js",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test tests/core.test.js",
    "lint": "eslint src",
    "validate": "node scripts/validate-project.js",
    "simulate": "npm run build && node scripts/simulate.js",
    "smoke:mock": "node scripts/smoke-runtime.js",
    "test:structural": "tsc -p tsconfig.validation.json && R8_TEST_BUILD=dist-validation node --test tests/core.test.js && R8_TEST_BUILD=dist-validation node scripts/smoke-runtime.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "@napi-rs/canvas": "1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^22.17.0",
    "eslint": "^9.33.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.0"
  }
}
